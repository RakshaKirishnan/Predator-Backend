# Server Configuration
PORT=8090
HOST=0.0.0.0

# InsightFace Biometric Engine
FACE_AUTH_MODEL=buffalo_l
FACE_AUTH_CTX_ID=-1
FACE_AUTH_MATCH_THRESHOLD=0.40

# MongoDB
FACE_AUTH_MONGO_URI=mongodb://localhost:27017
FACE_AUTH_MONGO_DB=predator
FACE_AUTH_USERS_COLLECTION=users
FACE_AUTH_INVITES_COLLECTION=invites
FACE_AUTH_USAGE_LOGS_COLLECTION=usage_logs
FACE_AUTH_APP_SETTINGS_COLLECTION=app_settings

# JWT Authentication & Cookie Security
FACE_AUTH_SECRET_KEY=change-this-to-a-secure-32-character-secret-key
FACE_AUTH_REFRESH_SECRET_KEY=change-this-to-a-secure-32-character-refresh-key
FACE_AUTH_JWT_ALGORITHM=HS256
FACE_AUTH_ACCESS_TOKEN_EXPIRE_MIN=60
FACE_AUTH_REFRESH_TOKEN_EXPIRE_HRS=24
FACE_AUTH_COOKIE_SAMESITE=lax
FACE_AUTH_COOKIE_SECURE=false
# FACE_AUTH_COOKIE_DOMAIN=

# SMTP Email Configuration for Member Invitations
FACE_AUTH_SMTP_SERVER=smtp.gmail.com
FACE_AUTH_SMTP_PORT=587
FACE_AUTH_SMTP_USERNAME=your-smtp-email@gmail.com
FACE_AUTH_SMTP_PASSWORD=your-app-password
FACE_AUTH_FROM_EMAIL=your-smtp-email@gmail.com
FACE_AUTH_FROM_ALIAS=PREDATOR Security
FACE_AUTH_INVITE_LINK_BASE=http://localhost:3000/auth/accept-invite
FACE_AUTH_INVITE_TTL_HOURS=48
